+/* The CP owns the station IP stack. AP-only ipconfig changes no live CP state.
+ * Complete the advertised CLI using its existing BK_CMD_SET_NET_INFO handler;
+ * a genuine CP GOT_IP event remains responsible for updating the AP link. */
+int breathon_set_cp_ipv4(const char *ip, const char *mask, const char *gateway, const char *dns)
+{
+    const char *values[] = {ip, mask, gateway, dns};
+    struct {
+        wdrv_cmd_hdr header;
+        char address[4][NETIF_IP4_STR_LEN];
+    } request = {0};
+    wdrv_cmd_cfm confirm = {0};
+    ip4_addr_t parsed;
+    _Static_assert(sizeof(request) == 12 + 4 * 16, "Pinned CP netinfo ABI changed");
+    for (int i = 0; i < 4; ++i) {
+        if (!values[i]) return -2;
+        size_t length = strlen(values[i]);
+        if (length == 0 || length >= NETIF_IP4_STR_LEN ||
+            !ip4addr_aton(values[i], &parsed)) return -2;
+        memcpy(request.address[i], values[i], length);
+    }
+    request.header.cmd_id = BK_CMD_SET_NET_INFO;
+    request.header.len = sizeof(request.address);
+    confirm.waitcfm = WDRV_CMD_WAITCFM;
+    return wdrv_tx_msg((uint8_t *)&request, sizeof(request), &confirm, NULL);
+}
+static void breathon_set_netinfo(int argc, char **argv)
+{
+    if (argc != 6) {
+        printf("BREATHON_STATIC_IP invalid arguments\r\n");
+        return;
+    }
+    int result = breathon_set_cp_ipv4(argv[2], argv[3], argv[4], argv[5]);
+    printf("BREATHON_STATIC_IP request_rc=%d\r\n", result);
+}
