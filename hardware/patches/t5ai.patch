+/* Association proof for application persistence/static-IP guards. CP obtains
+ * this SSID from rw_msg_get_bss_info, not the requested station configuration. */
+bool breathon_wifi_associated_ssid_matches(const char *ssid)
+{
+    wifi_link_status_t actual = {0};
+    bk_err_t result = bk_wifi_sta_get_link_status(&actual);
+    bool matches = result == BK_OK && ssid && ssid[0] && actual.aid > 0 &&
+                   (actual.state == WIFI_LINKSTATE_STA_CONNECTED || actual.state == WIFI_LINKSTATE_STA_GOT_IP) &&
+                   memchr(actual.ssid, 0, sizeof(actual.ssid)) && !strcmp(actual.ssid, ssid);
+    volatile uint8_t *secret = (volatile uint8_t *)&actual;
+    for (size_t i = 0; i < sizeof(actual); ++i) secret[i] = 0;
+    return matches;
+}
